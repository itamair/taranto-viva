<?php

/**
 * @file
 * AI TMGMT module file.
 */

use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;

/**
 * Implements hook_entity_delete().
 */
#[LegacyHook]
function ai_tmgmt_entity_delete(EntityInterface $entity): void {
  /** @var \Drupal\ai_tmgmt\Hook\AiTranslatorHook $hooks */
  $hooks = \Drupal::service('ai_tmgmt.hook');
  $hooks->entityDelete($entity);
}
