/**
 * Create entity_mesh_tracker table for tracking entities to be processed.
 */
function entity_mesh_update_10018() {
  $schema = \Drupal::database()->schema();
  $schema_definition = entity_mesh_schema();

  if (!$schema->tableExists('entity_mesh_tracker')) {
    $schema->createTable('entity_mesh_tracker', $schema_definition['entity_mesh_tracker']);
    return (string) new TranslatableMarkup('Created entity_mesh_tracker table for tracking entities to be processed.');
  }

  return (string) new TranslatableMarkup('entity_mesh_tracker table already exists.');
}

/**
 * Set default values for cron_enabled and cron_limit configuration.
 */
function entity_mesh_update_10019() {
  $config = \Drupal::configFactory()->getEditable('entity_mesh.settings');

  // Set default cron_enabled to TRUE if not already set.
  if ($config->get('cron_enabled') === NULL) {
    $config->set('cron_enabled', TRUE);
  }

  // Set default cron_limit to 50 if not already set.
  if ($config->get('cron_limit') === NULL) {
    $config->set('cron_limit', 50);
  }

  $config->save();

  return (string) new TranslatableMarkup('Set default values for cron configuration: cron_enabled=@enabled, cron_limit=@limit.', [
    '@enabled' => $config->get('cron_enabled') ? 'TRUE' : 'FALSE',
    '@limit' => $config->get('cron_limit'),
  ]);
}

/**
 * Reimport entity mesh views for node, media, and taxonomy entities.
 */
function entity_mesh_update_10020() {
  $config_factory = \Drupal::configFactory();
  $messages = [];

  // List of views to reimport with their UUIDs to preserve.
  $views = [
    'entity_mesh_node' => 'views.view.entity_mesh_node',
    'entity_mesh_media' => 'views.view.entity_mesh_media',
    'entity_mesh_taxonomy' => 'views.view.entity_mesh_taxonomy',
    'entity_mesh_domains' => 'views.view.entity_mesh_domains',
    'entity_mesh' => 'views.view.entity_mesh',
  ];

  // Preserve UUIDs and delete existing views.
  $uuids = [];
  foreach ($views as $view_id => $config_name) {
    $existing_config = $config_factory->getEditable($config_name);
    if (!$existing_config->isNew()) {
      $uuids[$view_id] = $existing_config->get('uuid');
      $existing_config->delete();
      $messages[] = "Deleted existing view: {$view_id}";
    }
  }

  // Reimport views from optional config.
  $path_to_module = \Drupal::service('extension.path.resolver')->getPath('module', 'entity_mesh');
  $config_path = $path_to_module . '/config/optional';
  $config_source = new FileStorage($config_path);

  // Install the specific view configurations.
  foreach ($views as $view_id => $config_name) {
    $config_data = $config_source->read($config_name);
    if ($config_data) {
      $new_config = $config_factory->getEditable($config_name);
      $new_config->setData($config_data);

      // Restore UUID if it existed.
      if (isset($uuids[$view_id])) {
        $new_config->set('uuid', $uuids[$view_id]);
      }

      $new_config->save();
      $messages[] = "Reimported view: {$view_id}";
    }
    else {
      $messages[] = "Warning: Could not read config for {$view_id}";
    }
  }

  return (string) new TranslatableMarkup('Reimported entity mesh views: @views', [
    '@views' => implode(', ', $messages),
  ]);
}

/**
 * Remove duplicate target_scheme_1 filter from entity_mesh view.
 */
function entity_mesh_update_10021() {
  $config_factory = \Drupal::configFactory();
  $config_name = 'views.view.entity_mesh';

  // Preserve UUID and delete existing view.
  $existing_config = $config_factory->getEditable($config_name);
  $uuid = NULL;
  if (!$existing_config->isNew()) {
    $uuid = $existing_config->get('uuid');
    $existing_config->delete();
  }

  // Reimport view from optional config.
  $path_to_module = \Drupal::service('extension.path.resolver')->getPath('module', 'entity_mesh');
  $config_path = $path_to_module . '/config/optional';
  $config_source = new FileStorage($config_path);

  $config_data = $config_source->read($config_name);
  if ($config_data) {
    $new_config = $config_factory->getEditable($config_name);
    $new_config->setData($config_data);

    // Restore UUID if it existed.
    if ($uuid) {
      $new_config->set('uuid', $uuid);
    }

    $new_config->save();
  }

  return (string) new TranslatableMarkup('Reimported entity mesh view: views.view.entity_mesh');
}
