{{ attach_library('search_api_typesense/search') }}

<div id="searchbox-container--{{ block_uuid }}" class="searchbox-container">
  <div id="searchbox--{{ block_uuid }}"></div>
</div>

<div id="search-results-container--{{ block_uuid }}" class="search-results-container">
  <div class="facets-container">
    {% for facet in facets %}
      <div class="facet-wrapper facet-type-{{ facet.type }}">
        <h3>{{ facet.label }}</h3>
        <div id="facet-{{ facet.name }}--{{ block_uuid }}"></div>
      </div>
    {% endfor %}
  </div>

  <div class="search-results-list">
    {% for parameters in collection_render_parameters %}
      <div id="results-{{ parameters.collection_name }}--{{ block_uuid }}" class="search-results-collection-wrapper">
        <h2>{{ parameters.collection_label }}</h2>
        <div id="stats-{{ parameters.collection_name }}--{{ block_uuid }}"></div>
        <div id="hits-{{ parameters.collection_name }}--{{ block_uuid }}"></div>
      </div>
    {% endfor %}
    <div id="pagination--{{ block_uuid }}" class="pagination"></div>
  </div>

</div>
