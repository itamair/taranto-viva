{
    "name": "drupal/search_api_typesense",
    "description": "Provides Typesense backend to Search API.",
    "type": "drupal-module",
    "keywords": ["Drupal", "Search", "Search API", "Typesense"],
    "homepage": "https://drdupal.org/project/search_api_typesense",
    "license": "GPL-2.0+",
    "authors": [
        {
            "name": "Christopher Torgalson",
            "email": "manager@bedlamhotel.com"
        },
        {
            "name": "Luca Lusso",
            "email": "lussoluca@gmail.com"
        }
    ],
    "support": {
        "issues": "https://www.drupal.org/project/issues/search_api_typesense",
        "source": "https://git.drupalcode.org/project/search_api_typesense"
    },
    "require": {
        "php": ">=8.1",
        "drupal/core": ">=10.3 || ^11",
        "typesense/typesense-php": "v5.1",
        "drupal/search_api": "^1.0@beta"
    },
    "require-dev": {
        "drush/drush": "^12 || ^13",
        "drupal/ai": "^1.0",
        "drupal/ai_provider_openai": "^1.0@beta",
        "drupal/webprofiler": "^10.1 || ^11",
        "mglaman/phpstan-drupal": "^1.1 || ^2",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-phpunit": "1.4.x-dev || ^2",
        "phpstan/phpstan-strict-rules": "^1.5 || ^2",
        "previousnext/coding-standard": "^1.0",
        "phpmd/phpmd" : "@stable"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "tbachert/spi": true
        }
    }
}
