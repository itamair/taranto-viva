parameters:
    level: 5
    fileExtensions:
        - php
        - module
        - inc
        - install
        - theme
        - profile
    reportUnmatchedIgnoredErrors: false
    treatPhpDocTypesAsCertain: false
    stubFiles:
      - stubs/Collections.stub
      - stubs/Documents.stub
      - stubs/ItemInterface.stub
    typeAliases:
      TypesenseSearchParameters: 'array{q: string, query_by: string, filter_by: string, sort_by: string}'
      TypesenseDocument: 'array<array-key, mixed>'
      TypesenseCollection: 'array{num_documents: int, name: string, fields: array{name: string, type: string, facet: bool}, default_sorting_field: string}'
