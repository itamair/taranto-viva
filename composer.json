        "drupal/pathauto": "^1.11",
        "drupal/pcb": "^4.0",
        "drupal/permissions_fixer": "^2.0",
        "drupal/photoswipe": "^5.0",
        "drupal/popup_message": "3.0.3",
        "drupal/queue_ui": "^3.1",
        "drupal/r4032login": "^2.2",
        "drupal/range": "^1.5",
        "drupal/rate": "^3.2",
        "drupal/readmore": "^2.0@alpha",
        "drupal/redirect": "^1.13",
        "drupal/replicate": "^1.0",
        "drupal/replicate_ui": "^1.0",
