        "drupal/image_styles_generator": "^1.2",
        "drupal/jquery_deprecated_functions": "^1.0",
        "drupal/jquery_ui": "^1.6",
        "drupal/jquery_ui_accordion": "^2.1",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/json_field": "^1.4",
        "drupal/jsonapi_extras": "^3.28",
        "drupal/klaro": "^3.1",
