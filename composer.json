{
    "name": "drupal/recommended-project",
    "description": "Project template for Drupal projects with a relocated document root",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "homepage": "https://www.drupal.org/project/drupal",
    "support": {
        "docs": "https://www.drupal.org/docs/user_guide/en/index.html",
        "chat": "https://www.drupal.org/node/314178"
    },
    "repositories": {
        "drupal": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "Asset Packagist": {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        },
        "jsoneditor": {
            "type": "package",
            "package": {
                "name": "josdejong/jsoneditor",
                "version": "v5.29.1",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/josdejong/jsoneditor/archive/v5.29.1.zip",
                    "type": "zip"
                },
                "source": {
                    "url": "https://github.com/josdejong/jsoneditor",
                    "type": "git",
                    "reference": "v5.29.1"
                }
            }
        },
        "jquery-jsonview": {
            "type": "package",
            "package": {
                "name": "yesmeck/jquery-jsonview",
                "version": "v1.2.3",
                "type": "drupal-library",
                "dist": {
                    "url": "https://github.com/yesmeck/jquery-jsonview/archive/v1.2.3.zip",
                    "type": "zip"
                },
                "source": {
                    "url": "https://github.com/yesmeck/jquery-jsonview",
                    "type": "git",
                    "reference": "v1.2.3"
                }
            }
        }
    },

    "require": {
        "ext-json": "*",
        "composer/installers": "^2.0",
        "cweagans/composer-patches": "^1.7",
        "drupal/admin_toolbar": "^3.4",
        "drupal/ai": "^1.2@RC",
        "drupal/ai_agents": "^1.1",
        "drupal/ai_provider_amazeeio": "^1.1",
        "drupal/ai_provider_anthropic": "^1.0",
        "drupal/ai_provider_deepseek": "^1.0@alpha",
        "drupal/ai_provider_litellm": "^1.1",
        "drupal/ai_provider_openai": "^1.0",
        "drupal/ai_tmgmt": "^1.0@beta",
        "drupal/ai_vdb_provider_pinecone": "^1.0@beta",
        "drupal/auto_entitylabel": "^3.0@beta",
        "drupal/backup_migrate": "^5.0",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/blazy": "^3.0",
        "drupal/bpmn_io": "^2.0",
        "drupal/cer": "^5.0@beta",
        "drupal/chosen": "^3.0",
        "drupal/color_field": "^3.0",
        "drupal/colorbox": "^2.0",
        "drupal/conditional_fields": "^4.0@alpha",
        "drupal/config_inspector": "^2.1",
        "drupal/content_access": "^2.1@RC",
        "drupal/core-composer-scaffold": "^11",
        "drupal/core-project-message": "^11",
        "drupal/core-recommended": "^11",
        "drupal/date_filter": "^1.0",
        "drupal/devel_entity_updates": "^5.0",
        "drupal/duplicate_role": "^1.3",
        "drupal/eca": "^2.1",
        "drupal/eca_cm": "^1.0",
        "drupal/entity_mesh": "^1.1",
        "drupal/entity_reference_purger": "^1.0@beta",
        "drupal/entity_reference_revisions": "^1.10",
        "drupal/entity_type_clone": "^4.0",
        "drupal/entity_usage": "^2.0@beta",
        "drupal/feeds_ex": "^1.0@beta",
        "drupal/feeds_tamper": "^2.0@beta",
        "drupal/field_group": "^4.0",
        "drupal/field_permissions": "^1.2",
        "drupal/file_delete": "^3.0",
        "drupal/geocoder": "^4.10",
        "drupal/geofield": "^10.3",
        "drupal/geofield_map": "^11.1",
        "drupal/google_tag": "^2.0",
        "drupal/graphql_compose": "^2.0",
        "drupal/image_style_warmer": "^1.3@RC",
        "drupal/image_styles_generator": "^1.2",
        "drupal/jquery_ui": "^1.6",
        "drupal/jquery_ui_accordion": "^2.1",
        "drupal/jquery_ui_datepicker": "^2.1",
        "drupal/json_field": "^1.4",
        "drupal/jsonapi_extras": "^3.23",
        "drupal/layout_builder_styles": "^2.0",
        "drupal/leaflet": "^10.4",
        "drupal/leaflet_choropleth": "^1.0",
        "drupal/masquerade": "^2.0@RC",
        "drupal/meaofd": "^1.1",
        "drupal/media_entity_slideshow": "^2.5",
        "drupal/media_image_metadata": "^1.0",
        "drupal/media_library_importer": "^2.0",
        "drupal/metatag": "^2.1",
        "drupal/modeler_api": "^1.0",
        "drupal/monolog": "^3.0",
        "drupal/optional_end_date": "^1.3",
        "drupal/paragraphs": "^1.20",
        "drupal/pathauto": "^1.11",
        "drupal/pcb": "^4.0",
        "drupal/photoswipe": "^5.0",
        "drupal/popup_message": "3.0.3",
        "drupal/queue_ui": "^3.1",
        "drupal/r4032login": "^2.2",
        "drupal/range": "^1.5",
        "drupal/rate": "^3.2",
        "drupal/replicate": "^1.0",
        "drupal/replicate_ui": "^1.0",
        "drupal/rmkv": "^2.2",
        "drupal/search_api": "^1.39",
        "drupal/search_api_typesense": "^1.1",
        "drupal/seckit": "^2.0",
        "drupal/single_image_formatter": "^2.0",
        "drupal/slick": "^3.0",
        "drupal/svg_image": "^3.0",
        "drupal/tmgmt": "^1.15",
        "drupal/token": "^1.11",
        "drupal/upgrade_status": "^4.3",
        "drupal/uuid_extra": "^2.0",
        "drupal/varbase_ai_agents": "~1.0.0",
        "drupal/viewfield": "^3.0@beta",
        "drupal/views_attach_library": "^3.0",
        "drupal/views_base_url": "^2.1",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.2",
        "drupal/views_daterange_filters": "^1.0@alpha",
        "drupal/views_geojson": "^1.3",
        "drupal/views_slideshow": "^5.0",
        "drupal/visitors": "^2.31",
        "drupal/votingapi": "4.0.x-dev@dev",
        "drupal/watchdog_statistics": "^1.0",
        "geocoder-php/arcgis-online-provider": "^4.4",
        "geocoder-php/google-maps-provider": "^4.7",
        "geocoder-php/photon-provider": "^0.6.0",
        "itamair/geophp": "^1.8",
        "oomphinc/composer-installers-extender": "^2.0",
        "pschocke/google-maps-links": "dev-master"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "allowed-packages": ["drupal/claude_code"]
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "web/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "web/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "web/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "patches": {
            "drupal/core": {
                "#3275276 Removing a relationship that is used by a filter can prevent access to editing a view": "https://www.drupal.org/files/issues/2023-04-19/3275276-18.patch"
            },
            "drupal/viewfield": {
                "#3381787 Getting PHP errors when setting default value": "https://www.drupal.org/files/issues/2023-08-21/3381787.patch"
            },
            "drupal/entity_reference_revisions": {
                "#2799479 Views doesn't recognize relationship to host": "https://www.drupal.org/files/issues/2024-08-24/entity_reference_revisions-2799479-231--no-tests.patch"
            }
        }
    },
    "require-dev": {
        "drupal/claude_code": "^1.0",
        "mglaman/phpstan-drupal": "^1.2",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-deprecation-rules": "^1.1"
    }
}
