        "drupal/ai_vdb_provider_pinecone": "^1.1@beta",
        "drupal/auto_entitylabel": "^3.0@beta",
        "drupal/autocomplete_deluxe": "^2.1",
        "drupal/backup_migrate": "^5.0",
        "drupal/better_exposed_filters": "^7.1",
        "drupal/blazy": "^3.0",
