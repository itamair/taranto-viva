        "drupal/upgrade_status": "^4.3",
        "drupal/uuid_extra": "^2.0",
        "drupal/viewfield": "^3.0@beta",
        "drupal/views_attach_library": "^3.0",
        "drupal/views_base_url": "^2.1",
        "drupal/views_bulk_edit": "^3.0",
        "drupal/views_bulk_operations": "^4.2",
        "drupal/views_daterange_filters": "^1.0@alpha",
        "drupal/views_geojson": "^1.3",
        "drupal/views_slideshow": "^5.0.1",
        "drupal/visitors": "^2.31",
        "drupal/votingapi": "4.0.x-dev@dev",
        "drupal/warmer": "^2.0",
        "drupal/watchdog_statistics": "^1.0",
        "geocoder-php/arcgis-online-provider": "^4.4",
        "geocoder-php/google-maps-provider": "^4.7",
        "geocoder-php/photon-provider": "^0.6.0",
        "itamair/geophp": "^1.8",
        "league/commonmark": "^2.8",
        "michelf/php-markdown": "^2.0",
        "oomphinc/composer-installers-extender": "^2.0",
        "pschocke/google-maps-links": "dev-master",
        "sebastian/diff": "^6",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "phpstan/extension-installer": true,
            "symfony/runtime": true,
            "wikimedia/composer-merge-plugin": true
        },
        "sort-packages": true
    },
    "extra": {
        "drupal-scaffold": {
            "locations": {
                "web-root": "public_html/"
            },
            "allowed-packages": ["drupal/claude_code"]
        },
        "installer-paths": {
            "public_html/core": [
                "type:drupal-core"
            ],
            "public_html/libraries/{$name}": [
                "type:drupal-library",
                "type:npm-asset",
                "type:bower-asset"
            ],
            "public_html/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "public_html/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "public_html/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "public_html/modules/custom/{$name}": [
                "type:drupal-custom-module"
            ],
            "public_html/profiles/custom/{$name}": [
                "type:drupal-custom-profile"
            ],
            "public_html/themes/custom/{$name}": [
                "type:drupal-custom-theme"
            ]
        },
        "merge-plugin": {
            "include": [
                "web/modules/contrib/views_slideshow/composer.libraries.json",
                "web/modules/contrib/views_slideshow/modules/views_slideshow_cycle/composer.libraries.json"
            ]
        },
        "drupal-core-project-message": {
            "include-keys": [
                "homepage",
                "support"
            ],
            "post-create-project-cmd-message": [
                "<bg=blue;fg=white>                                                         </>",
                "<bg=blue;fg=white>  Congratulations, you’ve installed the Drupal codebase  </>",
                "<bg=blue;fg=white>  from the drupal/recommended-project template!          </>",
                "<bg=blue;fg=white>                                                         </>",
                "",
                "<bg=yellow;fg=black>Next steps</>:",
                "  * Install the site: https://www.drupal.org/docs/installing-drupal",
                "  * Read the user guide: https://www.drupal.org/docs/user_guide/en/index.html",
                "  * Get support: https://www.drupal.org/support",
                "  * Get involved with the Drupal community:",
                "      https://www.drupal.org/getting-involved",
                "  * Remove the plugin that prints this message:",
                "      composer remove drupal/core-project-message"
            ]
        },
        "patches": {
            "drupal/core": {
                "TypeError: Drupal\\Component\\Utility\\Html::escape(): Argument #1 ($text) must be of type string, null given": "https://git.drupalcode.org/project/drupal/-/merge_requests/12073/diffs.patch"
            },
            "drupal/viewfield": {
                "#3381787 Getting PHP errors when setting default value": "https://www.drupal.org/files/issues/2023-08-21/3381787.patch"
            },
            "drupal/entity_reference_revisions": {
                "#2799479 Views doesn't recognize relationship to host": "https://www.drupal.org/files/issues/2024-08-24/entity_reference_revisions-2799479-231--no-tests.patch"
            },
            "drupal/views_slideshow": {
                "#3574500 Install failed by missing tobia/jquery.pause": "https://www.drupal.org/files/issues/2026-02-26/df6cc272e72c650e1f84640d0705c177b42b9137.patch"
            },
            "drupal/simple_crawler": {
                "#3595534 Uncaught ParseException in $readability->parse breaks the correct scraping of multi $uris / links": "https://git.drupalcode.org/project/simple_crawler/-/merge_requests/4/diffs.patch"
            },
            "drupal/ai": {
                "#3580332 Error /ai_automators/src/PluginBaseClasses/VideoToText.php": "https://www.drupal.org/files/issues/2026-03-19/ai-videototext-shell-exec-fix%20%281%29.patch"
            },
            "drupal/feeds_ex":{
                "#3590881 add support for PHP 8.5 - jsonpath ^1.0": "https://git.drupalcode.org/project/feeds_ex/-/merge_requests/60/diffs.patch"
            }
        }
    },
    "require-dev": {
        "behat/mink-selenium2-driver": "^1.7",
        "mglaman/phpstan-drupal": "^2.0",
        "phpspec/prophecy-phpunit": "^2.5",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11"
    }
}
