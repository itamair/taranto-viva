        "drupal/mcp": "^1.2",
        "drupal/meaofd": "^1.1",
        "drupal/media_entity_slideshow": "^2.5",
        "drupal/media_image_metadata": "^1.0",
        "drupal/media_library_importer": "2.x-dev@dev",
        "drupal/metatag": "^2.1",
        "drupal/modeler_api": "^1.0",
        "drupal/monolog": "^3.0",
